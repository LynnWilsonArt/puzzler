[sub_resource type="GDScript" id="GDScript_in6qw"]
script/source = "# res://scene/puzzle/handle_popup_menu_selections.gd
extends PopupMenu

# Re-initialized dynamically inside _ready()
var game_scene: Node = null
var puzzle_node: Node = null


func _ready() -> void:
	if  Globals.debug:
		print(\"DEBUG -> handle_popup_menu_selections.gd -> _ready()\")
	# Connect the PopupMenu selection signal
	id_pressed.connect(_on_id_pressed)
	
	# Search dynamically up the tree to find the root 'game_scene'
	var current = self
	while current != null:
		if current.name == \"game_scene\":
			game_scene = current
			# Look for the Puzzle node child inside game_scene
			puzzle_node = current.get_node_or_null(\"Puzzle\") 
			break
		current = current.get_parent()
	
	# Safety checks to log if nodes are missing from the scene layout
	if game_scene == null:
		print(\"Warning: Could not find game_scene root node up the tree layout.\")
	if puzzle_node == null:
		print(\"Warning: Could not find Puzzle node child inside game_scene.\")


func _on_id_pressed(id: int) -> void:
	if  Globals.debug:
		print(\"DEBUG -> handle_popup_menu_selections.gd -> _on_id_pressed()\")
	match id:
		0: 
			print(\"Toggle Original Selected: \", id)
			if is_instance_valid(puzzle_node) and puzzle_node.has_method(\"_on_show_original_image_pressed\"):
				puzzle_node._on_show_original_image_pressed()
			else:
				print(\"Warning: Puzzle node or _on_show_original_image_pressed function not found!\")
		1: 
			print(\"Skip Selected: \", id)
			if is_instance_valid(game_scene) and game_scene.has_method(\"_on_get_puzzle\"):
				game_scene._on_get_puzzle()
				$\"../../Puzzle\".visible = true
				
			else:
				print(\"Warning: game_scene node or _on_get_puzzle() function not found!\")
		2: 
			print(\"Save Puzzle Selected: \", id)
		3: 
			print(\"Quit Selected: \", id)
			print(\"Quit button pressed\")
			get_tree().quit()
"

